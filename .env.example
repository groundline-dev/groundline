# Copy this file to .env and fill in the values you need.
# .env is git-ignored: never commit real keys.
# Both `make dev` and `docker compose` read it (see DEVELOPMENT.md).

# Anthropic API key for live model calls (these cost money).
ANTHROPIC_API_KEY=

# Database passwords. Generate each with `openssl rand -hex 24`: hex is safe in
# a URL, and Compose treats a `$` in a value as the start of a variable.
# POSTGRES_PASSWORD sets the admin login's password only when the database volume
# is first created; changing it here later doesn't change the database's.
POSTGRES_PASSWORD=
GROUNDLINE_DB_PASSWORD=

# The ports on this computer. Uncomment to change them.
# 5433, not 5432, so a Postgres installed on this computer can keep 5432.
# POSTGRES_HOST_PORT=5433
# APP_HOST_PORT=8000

# Who can reach the app in Compose: 127.0.0.1 is this computer only. A server
# that callers reach over the network sets 0.0.0.0.
# APP_BIND_ADDRESS=127.0.0.1

# The database from this computer, for `make dev`, scripts/db-setup and the
# database tests. Inside Compose, compose.yaml builds its own URLs.
DATABASE_URL=postgresql+psycopg://groundline:${GROUNDLINE_DB_PASSWORD}@localhost:${POSTGRES_HOST_PORT:-5433}/groundline
# The admin login. Only setup and the database tests use it; the app never does.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@localhost:${POSTGRES_HOST_PORT:-5433}/postgres
