# Copy this file to .env and fill in the values you need.
# .env is git-ignored: never commit real keys.

# Anthropic API key for live model calls (these cost money).
ANTHROPIC_API_KEY=

# The local database, for the API (see DEVELOPMENT.md, "Database").
# Pick your own password: scripts/db-setup creates the role with it.
DATABASE_URL=postgresql+psycopg://groundline:CHANGE_ME@localhost:5432/groundline
