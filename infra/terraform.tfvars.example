# Copy to terraform.tfvars (git-ignored) and fill in your name and email address.
# scripts/aws-deploy fills in region, tester_cidr and git_ref.

# Names your server's resources, so everyone sharing the AWS project can have
# one: 1 to 20 lowercase letters, digits and hyphens.
deployment_name = "alice"

budget_alert_email = "you@example.com"

# Both modes use HTTPS on the server's public IP; no domain needed.
# restricted: only this computer's public IP may access application routes.
# unrestricted: any caller IP may access them; protected routes need API keys.
# TCP/TLS 443 stays public for certificate validation in both modes.
# Switching modes updates the server in place; it keeps its data and address.
access_mode = "restricted"

# Optional: hours after its first boot until the server terminates itself,
# deleting its data. It's also the most make aws-reset-deadline can give it
# from the time you run it. 0 keeps it running.
# auto_terminate_hours = 8

# Optional: a bigger Graviton (arm64) server.
# instance_type = "t4g.medium"

# Optional: the app's settings, by their .env names (see .env.example). Leave
# one out to use the app's default. Changing them updates the running server
# in place with make aws-up; it keeps its data.
# app_settings = {
#   GROUNDLINE_CHECK_TIMEOUT_SECONDS = 120     # seconds a check may take
#   GROUNDLINE_MODEL_MAX_ATTEMPTS    = 3       # attempts per model call
#   GROUNDLINE_MAX_BODY_BYTES        = 5242880 # request body, in bytes
#   GROUNDLINE_MAX_SOURCE_CHARS      = 200000  # characters of source
#   GROUNDLINE_MAX_SUMMARY_CHARS     = 200000  # characters of summary
# }
