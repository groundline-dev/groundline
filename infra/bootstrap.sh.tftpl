#!/bin/bash
# groundline's startup script. Terraform fills in the $${...} values (main.tf),
# and cloud-init runs it once, as root, on the server's first boot. Shell
# variables are written $name, without braces, so Terraform leaves them alone.
#
# It installs what the server needs, mounts the data volume, clones the commit
# and runs its infra/server/apply, which writes .env and starts the Docker Compose services. It
# logs to /var/log/groundline-bootstrap.log, which scripts/aws-smoke-test prints
# if the app doesn't start. At the end it leaves /var/lib/groundline/bootstrap-done,
# or bootstrap-failed if a command failed. -E makes the ERR trap fire inside
# functions too.
set -Eeuo pipefail

log=/var/log/groundline-bootstrap.log
marker_dir=/var/lib/groundline
checkout=/opt/groundline
exec >>"$log" 2>&1
mkdir -p "$marker_dir"
trap 'echo "groundline bootstrap: failed at line $LINENO"; touch "$marker_dir/bootstrap-failed"' ERR
# cloud-init doesn't set HOME, and the Docker CLI keeps its settings there.
export HOME=/root

echo "groundline bootstrap: started at $(date -u)"

%{ if auto_terminate_seconds > 0 ~}
# The deadline: once it passes, a systemd timer shuts the server down, which
# terminates it (main.tf). It's set first, so a server whose startup fails still
# goes away. The timer checks every 5 minutes, and keeps checking after a reboot.
echo "$(( $(date +%s) + ${auto_terminate_seconds} ))" >"$marker_dir/terminate-at"
echo "groundline bootstrap: the server terminates itself at $(date -u -d "@$(cat "$marker_dir/terminate-at")")"
cat >/usr/local/sbin/groundline-expire <<'EOF'
#!/bin/sh
# Shuts the server down once the time in /var/lib/groundline/terminate-at passes.
# First it releases the Elastic IP, which would cost money with no server using
# it; terminating deletes the data volume, which scripts/aws-deploy marks to go
# with the server.
set -eu
deadline="$(cat /var/lib/groundline/terminate-at)"
if [ "$(date +%s)" -ge "$deadline" ]; then
  logger "groundline: the deadline passed, so the server is releasing its address and terminating"
  association="$(aws ec2 describe-addresses --region ${region} --allocation-ids ${eip_allocation_id} \
    --query 'Addresses[0].AssociationId' --output text 2>/dev/null || true)"
  case "$association" in "" | None) ;; *)
    aws ec2 disassociate-address --region ${region} --association-id "$association" || true ;;
  esac
  aws ec2 release-address --region ${region} --allocation-id ${eip_allocation_id} \
    || logger "groundline: couldn't release the Elastic IP; make aws-destroy releases it"
  systemctl poweroff
fi
EOF
chmod 755 /usr/local/sbin/groundline-expire
cat >/etc/systemd/system/groundline-expire.service <<'EOF'
[Unit]
Description=Shut the groundline server down once its deadline passes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/groundline-expire
EOF
cat >/etc/systemd/system/groundline-expire.timer <<'EOF'
[Unit]
Description=Check the groundline server's deadline every 5 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
systemctl enable --now groundline-expire.timer

%{ endif ~}

# The Elastic IP is associated once Terraform sees the server running, which
# replaces the address it starts with. Anything downloaded over that first
# address would be cut off, so nothing is until the Elastic IP is in place.
metadata=http://169.254.169.254/latest
read_metadata() {
  local token
  token="$(curl --disable --fail --silent --noproxy '*' --max-time 5 --request PUT \
    --header 'X-aws-ec2-metadata-token-ttl-seconds: 60' "$metadata/api/token")" || return 1
  curl --disable --fail --silent --noproxy '*' --max-time 5 \
    --header "X-aws-ec2-metadata-token: $token" "$metadata/meta-data/$1"
}
echo "groundline bootstrap: waiting for the Elastic IP"
for attempt in $(seq 1 120); do
  expected="$(read_metadata tags/instance/groundline-public-ip || true)"
  [ -n "$expected" ] && [ "$(read_metadata public-ipv4 || true)" = "$expected" ] && break
  [ "$attempt" -lt 120 ] || { echo "groundline bootstrap: the Elastic IP was never associated"; false; }
  sleep 5
done
echo "groundline bootstrap: the server's address is $expected"
# What to run: tags, not part of this script, so a new commit is applied in
# place by an upgrade (scripts/aws-deploy) rather than by a new server.
git_ref="$(read_metadata tags/instance/groundline-git-ref)"
repository_url="$(read_metadata tags/instance/groundline-repository-url)"

dnf install -y docker git openssl xfsprogs

# The data volume holds Docker's volumes (the database and the HTTPS
# certificates) and the database passwords, so they outlive the server. It's
# formatted only if it's new, and mounted before Docker first starts. Docker
# needs the mount to start (the drop-in below), so a missing volume never gets
# an empty database in its place.
data=/srv/groundline-data
device="${data_device}"
echo "groundline bootstrap: waiting for the data volume"
for attempt in $(seq 1 120); do
  [ -e "$device" ] && break
  [ "$attempt" -lt 120 ] || { echo "groundline bootstrap: the data volume never appeared at $device"; false; }
  sleep 5
done
if ! blkid "$device" >/dev/null 2>&1; then
  echo "groundline bootstrap: formatting the new data volume"
  mkfs.xfs -q -L groundline "$device"
fi
uuid="$(blkid -s UUID -o value "$device")"
mkdir -p "$data" /var/lib/docker/volumes
echo "UUID=$uuid $data xfs defaults,nofail 0 2" >>/etc/fstab
mount "$data"
mkdir -p "$data/docker-volumes" "$data/secrets"
chmod 700 "$data/secrets"
echo "$data/docker-volumes /var/lib/docker/volumes none bind,nofail,x-systemd.requires-mounts-for=$data 0 0" >>/etc/fstab
mount /var/lib/docker/volumes

# Refresh the public IP before Docker can restart any containers. A failed
# discovery prevents startup; it never falls back to HTTP or an internal CA.
# The directory mount lets Caddy see an atomically replaced configuration.
mkdir -p /etc/systemd/system/docker.service.d
cat >/etc/systemd/system/docker.service.d/groundline-https.conf <<'EOF'
[Unit]
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/docker/volumes

[Service]
ExecStartPre=/opt/groundline/infra/https/refresh-address
EOF
systemctl daemon-reload

# Amazon Linux doesn't package Compose or buildx (which Compose uses to build the
# image), so install them at pinned versions and check their sha256.
plugins=/usr/local/lib/docker/cli-plugins
mkdir -p "$plugins"
install_plugin() {
  local name="$1" url="$2" sha256="$3"
  curl --fail --silent --show-error --location --retry 3 --output "$plugins/$name" "$url"
  echo "$sha256  $plugins/$name" | sha256sum --check || { rm -f "$plugins/$name"; false; }
  chmod 755 "$plugins/$name"
}
install_plugin docker-compose \
  https://github.com/docker/compose/releases/download/v5.7.0/docker-compose-linux-aarch64 \
  15861535d14e26555736b49376c95e14bfd94285366c8446bfac7156a972e76f
install_plugin docker-buildx \
  https://github.com/docker/buildx/releases/download/v0.38.2/buildx-v0.38.2.linux-arm64 \
  46c0f334772de3cb0b341cc415caf7339fb5cfc8b8438ebcb5a10e7f23800d36

git clone --quiet "$repository_url" "$checkout"
git -C "$checkout" checkout --quiet --detach "$git_ref"
cd "$checkout"

# Docker starts at boot, so the containers come back after a reboot. The
# drop-in above runs refresh-address first, which the checkout has now.
systemctl enable --now docker
# Writes .env, from the passwords on the data volume and the Anthropic API key,
# then builds the image and starts Postgres, setup, the app and Caddy.
infra/server/apply

touch "$marker_dir/bootstrap-done"
echo "groundline bootstrap: done at $(date -u); the app starts once setup finishes"
