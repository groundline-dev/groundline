#!/bin/bash
# groundline's startup script. Terraform fills in the $${...} values (main.tf),
# and cloud-init runs it once, as root, on the server's first boot. Shell
# variables are written $name, without braces, so Terraform leaves them alone.
#
# It logs to /var/log/groundline-bootstrap.log, which scripts/aws-smoke-test
# prints if the app doesn't start. At the end it leaves
# /var/lib/groundline/bootstrap-done, or bootstrap-failed if a command failed.
# -E makes the ERR trap fire inside functions too.
set -Eeuo pipefail

log=/var/log/groundline-bootstrap.log
marker_dir=/var/lib/groundline
checkout=/opt/groundline
exec >>"$log" 2>&1
mkdir -p "$marker_dir"
trap 'echo "groundline bootstrap: failed at line $LINENO"; touch "$marker_dir/bootstrap-failed"' ERR
# cloud-init doesn't set HOME, and the Docker CLI keeps its settings there.
export HOME=/root

echo "groundline bootstrap: started at $(date -u)"

%{ if auto_terminate_seconds > 0 ~}
# The deadline: once it passes, a systemd timer shuts the server down, which
# terminates it (main.tf). It's set first, so a server whose startup fails still
# goes away. The timer checks every 5 minutes, and keeps checking after a reboot.
echo "$(( $(date +%s) + ${auto_terminate_seconds} ))" >"$marker_dir/terminate-at"
echo "groundline bootstrap: the server terminates itself at $(date -u -d "@$(cat "$marker_dir/terminate-at")")"
cat >/usr/local/sbin/groundline-expire <<'EOF'
#!/bin/sh
# Shuts the server down once the time in /var/lib/groundline/terminate-at passes.
set -eu
deadline="$(cat /var/lib/groundline/terminate-at)"
if [ "$(date +%s)" -ge "$deadline" ]; then
  logger "groundline: the deadline passed, so the server is shutting down and terminating"
  systemctl poweroff
fi
EOF
chmod 755 /usr/local/sbin/groundline-expire
cat >/etc/systemd/system/groundline-expire.service <<'EOF'
[Unit]
Description=Shut the groundline server down once its deadline passes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/groundline-expire
EOF
cat >/etc/systemd/system/groundline-expire.timer <<'EOF'
[Unit]
Description=Check the groundline server's deadline every 5 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
systemctl enable --now groundline-expire.timer

%{ endif ~}

# Docker starts at boot, so the containers come back after a reboot.
dnf install -y docker git openssl
systemctl enable --now docker

# Amazon Linux doesn't package Compose or buildx (which Compose uses to build the
# image), so install them at pinned versions and check their sha256.
plugins=/usr/local/lib/docker/cli-plugins
mkdir -p "$plugins"
install_plugin() {
  local name="$1" url="$2" sha256="$3"
  curl --fail --silent --show-error --location --retry 3 --output "$plugins/$name" "$url"
  echo "$sha256  $plugins/$name" | sha256sum --check || { rm -f "$plugins/$name"; false; }
  chmod 755 "$plugins/$name"
}
install_plugin docker-compose \
  https://github.com/docker/compose/releases/download/v5.7.0/docker-compose-linux-aarch64 \
  15861535d14e26555736b49376c95e14bfd94285366c8446bfac7156a972e76f
install_plugin docker-buildx \
  https://github.com/docker/buildx/releases/download/v0.38.2/buildx-v0.38.2.linux-arm64 \
  46c0f334772de3cb0b341cc415caf7339fb5cfc8b8438ebcb5a10e7f23800d36

git clone --quiet "${repository_url}" "$checkout"
git -C "$checkout" checkout --quiet --detach "${git_ref}"
cd "$checkout"

# .env, readable only by root. Hex passwords are safe in a URL and in Compose.
# Generated first, since a failed command inside echo "$(...)" wouldn't stop the script.
postgres_password="$(openssl rand -hex 24)"
groundline_db_password="$(openssl rand -hex 24)"
umask 077
{
  echo "POSTGRES_PASSWORD=$postgres_password"
  echo "GROUNDLINE_DB_PASSWORD=$groundline_db_password"
%{ if access_mode == "https" ~}
  echo "COMPOSE_FILE=compose.yaml:compose.https.yaml"
%{ else ~}
  echo "APP_BIND_ADDRESS=0.0.0.0"
%{ endif ~}
} >.env
chmod 600 .env

# The Anthropic API key is optional: without the parameter, the app starts and
# answers everything except model calls. Any other error stops the startup.
errors_file="$(mktemp)"
if anthropic_api_key="$(aws ssm get-parameter --region "${region}" --name "${anthropic_parameter_name}" \
  --with-decryption --query Parameter.Value --output text 2>"$errors_file")"; then
  echo "ANTHROPIC_API_KEY=$anthropic_api_key" >>.env
  echo "groundline bootstrap: read the Anthropic API key from ${anthropic_parameter_name}"
elif grep --quiet ParameterNotFound "$errors_file"; then
  echo "groundline bootstrap: ${anthropic_parameter_name} doesn't exist, so the app has no Anthropic API key"
else
  cat "$errors_file"
  false
fi
rm -f "$errors_file"
unset anthropic_api_key

%{ if access_mode == "https" ~}
# Refresh the public IP before Docker can restart any containers. A failed
# discovery prevents startup; it never falls back to HTTP or an internal CA.
# The directory mount lets Caddy see an atomically replaced configuration.
mkdir -p /etc/systemd/system/docker.service.d
cat >/etc/systemd/system/docker.service.d/groundline-https.conf <<'EOF'
[Unit]
Wants=network-online.target
After=network-online.target

[Service]
ExecStartPre=/opt/groundline/infra/https/refresh-address
EOF
systemctl daemon-reload
infra/https/refresh-address
%{ endif ~}
# Builds the image, then starts Postgres, setup and the app.
docker compose up -d --quiet-pull

touch "$marker_dir/bootstrap-done"
echo "groundline bootstrap: done at $(date -u); the app starts once setup finishes"
