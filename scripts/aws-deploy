#!/usr/bin/env bash
# Create (or update) your AWS test deployment with Terraform: the Compose stack
# at a given commit, on an EC2 instance reachable only from this computer's
# public IP. See DEVELOPMENT.md, "Deploying to AWS".
#
# Usage: scripts/aws-deploy            (make aws-deploy)
#        REF=<branch|tag|commit> scripts/aws-deploy
#
# The server runs REF (default HEAD), which must be pushed to GitHub. The Region
# is AWS_REGION, or the one `aws configure get region` gives. Rerunning it with
# the same commit after your IP changes updates only the security group; another
# commit replaces the server, and its data with it.
set -euo pipefail
cd "$(dirname "$0")/.."

source scripts/aws-common.sh

anthropic_parameter=/groundline/anthropic-api-key

for tool in terraform aws git curl; do
  command -v "$tool" >/dev/null || fail "$tool isn't installed (see DEVELOPMENT.md, \"Deploying to AWS\")"
done
[ -f infra/terraform.tfvars ] \
  || fail "infra/terraform.tfvars is missing: copy infra/terraform.tfvars.example and fill in your name and email"
grep --quiet '^[[:space:]]*deployment_name[[:space:]]*=' infra/terraform.tfvars \
  || fail "infra/terraform.tfvars has no deployment_name: add one, such as deployment_name = \"alice\" (see infra/terraform.tfvars.example)"

aws sts get-caller-identity --output text --query Account >/dev/null \
  || fail "the AWS CLI isn't signed in: run aws login"
region="${AWS_REGION:-$(aws configure get region || true)}"
[ -n "$region" ] || fail "no AWS Region: run aws configure set region <your project's Region>"

ref="${REF:-HEAD}"
commit="$(git rev-parse --verify --quiet "$ref^{commit}")" || fail "$ref isn't a commit"
git fetch --quiet --prune origin
[ -n "$(git for-each-ref --contains "$commit" refs/remotes/origin)" ] \
  || fail "$ref ($commit) isn't on GitHub yet: push it first, since the server clones it from there"

ip="$(curl --fail --silent --show-error --max-time 10 https://checkip.amazonaws.com | tr -d '[:space:]')" || ip=""
[[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || fail "couldn't find this computer's public IPv4 address (got '$ip')"

# Checks only that the parameter exists: its value never leaves AWS.
if ! errors="$(aws ssm get-parameter --region "$region" --name "$anthropic_parameter" 2>&1 >/dev/null)"; then
  case "$errors" in
    *ParameterNotFound*)
      echo "warning: $anthropic_parameter doesn't exist, so the server will have no Anthropic API key." >&2
      echo "         make aws-smoke works without it; make aws-smoke-live doesn't." >&2
      ;;
    *) fail "couldn't check $anthropic_parameter: $errors" ;;
  esac
fi

echo "Deploying $commit to $region, reachable only from $ip"
terraform -chdir=infra init -input=false
# Tells a new server from an updated one below, since only a new one gets a new deadline.
previous_instance="$(terraform -chdir=infra output -raw instance_id 2>/dev/null || true)"
terraform -chdir=infra apply \
  -var "region=$region" -var "tester_cidr=$ip/32" -var "git_ref=$commit"

echo
instance="$(terraform -chdir=infra output -raw instance_id)"
hours="$(terraform -chdir=infra output -raw auto_terminate_hours)"
if [ "$instance" != "$previous_instance" ]; then
  echo "The server is starting; it takes about 5 to 10 minutes. Check it with: make aws-smoke"
else
  echo "The server ($instance) was updated in place. Check it with: make aws-smoke"
fi

if [ "$hours" = 0 ]; then
  echo "It has no time limit, so it costs about \$17 a month until you run make aws-destroy."
  exit 0
fi
# A new server's clock starts when it first boots, about a minute from now. An
# existing one keeps its deadline, which only the server knows.
if [ "$instance" != "$previous_instance" ]; then
  when="about $(describe_deadline $(($(date +%s) + hours * 3600 + 60)))"
else
  when="$(on_server "cat $deadline_file" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ "$when" =~ ^[0-9]+$ ]]; then
    when="$(describe_deadline "$when")"
  else
    when="the time make aws-status shows"
  fi
fi
cat <<EOF

It terminates itself, with its data, at $when.
  make aws-status   shows how long it has left
  make aws-extend   moves it to $hours hours from now (make aws-extend HOURS=n for fewer)
When you're done, or once it has terminated itself, run make aws-destroy: terminating
removes only the server and its data, not its security group, IAM role, instance
profile or budget.
EOF
