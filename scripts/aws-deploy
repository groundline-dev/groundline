#!/usr/bin/env bash
# Create (or update) your AWS test deployment with Terraform: the Compose stack
# at a given commit, on an EC2 instance reachable only from this computer's
# public IP. See docs/deploying-to-aws.md.
#
# Usage: scripts/aws-deploy            (make aws-deploy)
#        REF=<branch|tag|commit> scripts/aws-deploy
#
# The server runs REF (default HEAD). It clones REF from REPOSITORY_URL if
# that's set, or else from whichever GitHub remote has it, such as your fork.
# The server clones without signing in, so that repository has to be public.
# The AWS project is the one make aws-up or make aws-project last chose, and
# the Region is that project's, or AWS_REGION. It first makes the deployment's
# data volume and Elastic IP (infra/data/), which outlive its servers, then the
# server (infra/). A server that's already running is upgraded in place over
# SSM: it checks out the commit and rebuilds and restarts the stack, keeping
# its data, address and certificate. Before changing anything, it says in plain
# words what will change and asks.
set -euo pipefail
cd "$(dirname "$0")/.."

source scripts/aws-common.sh

for tool in terraform aws git curl jq; do
  command -v "$tool" >/dev/null || fail "$tool isn't installed (see docs/deploying-to-aws.md)"
done
[ -f infra/terraform.tfvars ] \
  || fail "infra/terraform.tfvars is missing: copy infra/terraform.tfvars.example and fill in your name and email"
grep --quiet '^[[:space:]]*deployment_name[[:space:]]*=' infra/terraform.tfvars \
  || fail "infra/terraform.tfvars has no deployment_name: add one, such as deployment_name = \"alice\" (see infra/terraform.tfvars.example)"

use_project
access_mode="$(configured_access_mode)"
lifetime="$(configured_lifetime)"
guard_lasting_folder
anthropic_parameter="$(anthropic_parameter "$(deployment_name)")"

ref="${REF:-HEAD}"
commit="$(git rev-parse --verify --quiet "$ref^{commit}")" || fail "$ref isn't a commit"
for file in compose.https.yaml infra/https/Caddyfile infra/https/refresh-address; do
  git cat-file -e "$commit:$file" 2>/dev/null \
    || fail "$ref doesn't include HTTPS support ($file). Deploy a commit with HTTPS support."
done
git cat-file -e "$commit:infra/server/apply" 2>/dev/null \
  || fail "$ref is too old to keep its data on a data volume (it has no infra/server/apply). Deploy a newer commit."
# Reject earlier HTTPS implementations that lack source-IP access enforcement.
git show "$commit:infra/https/refresh-address" | grep groundline-allowed-cidr >/dev/null \
  || fail "$ref doesn't include HTTPS access-mode support. Deploy a revision with restricted/unrestricted modes."
if [ -n "${REPOSITORY_URL:-}" ]; then
  repository_url="$REPOSITORY_URL"
else
  git fetch --quiet --all --prune
  repository_url="$(remote_with "$commit")" \
    || fail "$ref ($commit) isn't on GitHub yet: push it to your fork or a branch first, since the server clones it from there"
fi
GIT_TERMINAL_PROMPT=0 git ls-remote --quiet "$repository_url" HEAD >/dev/null 2>&1 \
  || fail "the server can't clone $repository_url: it clones without signing in, so the repository has to be public on GitHub"
# What to call the commit: REF_NAME from make aws-up, REF as given, or the branch checked out.
ref_name="${REF_NAME:-${REF:-$(git branch --show-current)}}"

tester_args=()
allowed_cidr=0.0.0.0/0
if [ "$access_mode" = restricted ]; then
  ip="$(public_ipv4)"
  allowed_cidr="$ip/32"
  tester_args=(-var "tester_cidr=$allowed_cidr")
  exposure="application accessible only from $ip over HTTPS; TLS 443 stays public for certificate validation"
else
  exposure="application accessible from any caller IP over HTTPS; protected API endpoints require API keys"
fi

echo "Deploying ${commit:0:7}${ref_name:+ ($ref_name)} from $repository_url"
echo "to $(project_label) in $region, $exposure."

# Checks only that the parameter exists: its value never leaves AWS. make aws-up
# has already warned about a missing key, so only a direct run warns here.
if ! errors="$(aws ssm get-parameter --region "$region" --name "$anthropic_parameter" 2>&1 >/dev/null)"; then
  case "$errors" in
    *ParameterNotFound*)
      if top_level; then
        echo
        warn "the server will have no Anthropic API key: $anthropic_parameter doesn't exist."
        bullet "make aws-smoke works without it; make aws-smoke-live doesn't."
      fi
      ;;
    *) fail "couldn't check $anthropic_parameter: $errors" ;;
  esac
fi
init_roots
# Tells a new server from an updated one below, since only a new one gets a new deadline.
previous_instance="$(terraform -chdir=infra output -raw instance_id 2>/dev/null || true)"
# A server made before deployments had a data volume keeps its database on its
# own disk. Its data is disposable, so it's replaced rather than moved.
if [ -n "$previous_instance" ] \
  && [ -z "$(terraform -chdir=infra/data output -raw volume_id 2>/dev/null || true)" ]; then
  fail "your server ($previous_instance) was made before deployments kept their data on a data volume. Run make aws-destroy, then make aws-up for a new one."
fi

# The data volume and the address first: the server is attached to them.
data_args=(-var "region=$region" -var "deployment_name=$(deployment_name)" -var "lifetime=$lifetime")
for setting in instance_type data_volume_gib; do
  value="$(tfvars_value "$setting")"
  [ -z "$value" ] || data_args+=(-var "$setting=$value")
done
plan_and_apply infra/data "the data volume and address are unchanged." "${data_args[@]}"

# Cancelling the server's plan leaves the volume and address made above, and
# they cost money, so it says so. (The server's plan can't come first: the
# server finds them by their tags.)
if [ -z "$previous_instance" ] \
  && [ -n "$(terraform -chdir=infra/data output -raw volume_id 2>/dev/null || true)" ]; then
  cancel_message="canceled: no server was created. Its data volume and address stay, for about \$$(kept_data_cost "$(terraform -chdir=infra/data output -raw data_volume_gib 2>/dev/null || true)") a month: make aws-deploy uses them, and make aws-destroy deletes them."
fi
plan_and_apply infra "Terraform configuration is unchanged for ${commit:0:7}; checking live HTTPS access next." \
  -var "region=$region" ${tester_args[@]+"${tester_args[@]}"} -var "git_ref=$commit" \
  -var "access_mode=$access_mode" \
  -var "repository_url=$repository_url"

instance="$(terraform -chdir=infra output -raw instance_id)"
hours="$(terraform -chdir=infra output -raw auto_terminate_hours)"
# A disposable server's data volume goes with it when it terminates itself, so
# a forgotten one leaves nothing that costs money; a lasting one's never does.
# Terraform can't set this for an attached volume, so it's set here; it's the
# same on every run.
delete_on_termination=true
[ "$lifetime" = disposable ] || delete_on_termination=false
aws ec2 modify-instance-attribute --region "$region" --instance-id "$instance" \
  --block-device-mappings "[{\"DeviceName\":\"/dev/sdf\",\"Ebs\":{\"DeleteOnTermination\":$delete_on_termination}}]" \
  || fail "couldn't set whether the data volume of $instance goes with it; run make aws-deploy again"
# A server that was already running is upgraded in place: it waits for its
# tags to show this run's access settings, checks out the commit, and runs the
# new commit's infra/server/apply, which rewrites .env (reading the Anthropic
# API key again), rebuilds the image and restarts what changed. Caddy reloads
# its address and access settings. A disposable server's time limit starts
# again, as a new server's would. Run every time, so a run that was
# interrupted, or one that changes nothing in Terraform, still leaves the server
# on this commit.
if [ "$instance" = "$previous_instance" ]; then
  reset_deadline=""
  [ "$hours" = 0 ] || reset_deadline="echo \$((\$(date +%s) + $hours * 3600)) >$deadline_file.new && mv $deadline_file.new $deadline_file"
  # A lasting deployment's data is copied before it moves to a newer commit, so
  # a bad database migration can be undone: restore the snapshot, then deploy
  # the older commit. Only the newest is kept; it's a way back from one
  # upgrade, not a backup. So a run that doesn't move forward (the same commit,
  # for settings or a retry, or a rollback) keeps it rather than replacing it
  # with a copy of data the newer commit may already have migrated.
  if [ "$lifetime" = lasting ]; then
    # What the server runs: Terraform has already moved the tag, and an
    # upgrade that failed partway leaves a tag the server never reached.
    server_commit="$(on_server "git -C /opt/groundline rev-parse HEAD" | tr -d '[:space:]')" \
      && [[ "$server_commit" =~ ^[0-9a-f]{40}$ ]] \
      || fail "couldn't ask the server which commit it runs, so it wasn't upgraded; run make aws-deploy again"
    if [ "$server_commit" = "$commit" ]; then
      check_ok "no snapshot: the server already runs ${commit:0:7}, so its pre-upgrade snapshot is kept"
    elif git merge-base --is-ancestor "$commit" "$server_commit" 2>/dev/null; then
      check_ok "no snapshot: this rolls back from ${server_commit:0:7}, so the snapshot from before it is kept, for restoring"
    else
      doing "Taking a snapshot of the data volume"
      echo "It waits until the snapshot is complete, which takes a minute or more."
      volume="$(output volume_id infra/data)"
      snapshot="$(aws ec2 create-snapshot --region "$region" --volume-id "$volume" \
        --description "groundline $(deployment_name), before upgrading to ${commit:0:7}" \
        --tag-specifications "ResourceType=snapshot,Tags=[{Key=app,Value=groundline},{Key=deployment,Value=$(deployment_name)},{Key=groundline-pre-upgrade,Value=${commit:0:7}}]" \
        --query SnapshotId --output text)" \
        || fail "couldn't take a snapshot of the data volume $volume, so the server wasn't upgraded"
      # The older snapshots go only once this one is usable.
      aws ec2 wait snapshot-completed --region "$region" --snapshot-ids "$snapshot" \
        || fail "the snapshot $snapshot of $volume didn't complete, so the server wasn't upgraded. The older snapshots are kept; run make aws-deploy again"
      check_ok "took $snapshot of $volume"
      for old in $(aws ec2 describe-snapshots --region "$region" --owner-ids self \
        --filters "Name=tag:deployment,Values=$(deployment_name)" Name=tag-key,Values=groundline-pre-upgrade \
        --query 'Snapshots[].SnapshotId' --output text); do
        [ "$old" != "$snapshot" ] || continue
        if aws ec2 delete-snapshot --region "$region" --snapshot-id "$old"; then
          check_ok "deleted the older snapshot $old"
        else
          check_warn "couldn't delete the older snapshot $old; delete it in the AWS console"
        fi
      done
    fi
  fi
  # The settings Terraform just tagged, which infra/server/apply waits to see.
  # A commit from before it waited ignores them.
  expected_settings="$(terraform -chdir=infra output -json app_settings 2>/dev/null \
    | jq -r 'to_entries | sort_by(.key)[] | "\(.key)=\(.value)"' 2>/dev/null | tr '\n' ' ' | sed 's/ $//' || true)"
  doing "Upgrading your server ($instance) in place to ${commit:0:7}"
  echo "It keeps its data, address and HTTPS certificate. This takes a few minutes."
  upgraded="$(on_server "set -eu; cd /opt/groundline; attempts=0
until infra/https/refresh-address '$access_mode' '$allowed_cidr'; do
  attempts=\$((attempts + 1)); [ \"\$attempts\" -lt 12 ] || exit 1; sleep 5
done
git fetch --quiet '$repository_url' '$commit'
git checkout --quiet --detach '$commit'
${reset_deadline}
GROUNDLINE_EXPECTED_SETTINGS='$expected_settings' infra/server/apply
docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile" 1800)" \
    || fail "couldn't upgrade the server; do not report deployment success. Retry make aws-deploy, or run REF=<the previous commit> make aws-deploy to go back."
  grep --quiet "groundline: running $commit" <<<"$upgraded" \
    || fail "the server didn't report running ${commit:0:7} after the upgrade; retry make aws-deploy"
  echo
  ok "upgraded your server ($instance) to ${commit:0:7}. It kept its data and address."
elif [ -n "$plan_changed" ]; then
  echo
  ok "created your server. It takes about 5 to 10 minutes to start."
fi

# The settings that differ from the app's defaults, so what the server runs
# with is in view after every deploy.
settings="$(terraform -chdir=infra output -json app_settings 2>/dev/null \
  | jq -r 'to_entries[] | "\(.key) = \(.value)"' 2>/dev/null || true)"
echo
if [ -n "$settings" ]; then
  echo "It runs with these app settings (app_settings in infra/terraform.tfvars):"
  while IFS= read -r setting; do bullet "$setting"; done <<<"$settings"
else
  echo "It runs with the app's default settings (app_settings in infra/terraform.tfvars changes them)."
fi

# The deadline, as the server's deadline file would hold it. A new server's
# clock starts when it first boots, about a minute from now. An existing one
# keeps its deadline, which only the server knows.
if [ "$hours" = 0 ]; then
  deadline=none
elif [ "$instance" != "$previous_instance" ]; then
  deadline=$(($(date +%s) + hours * 3600 + 60))
else
  deadline="$(on_server "cat $deadline_file" 2>/dev/null | tr -d '[:space:]' || true)"
  [[ "$deadline" =~ ^[0-9]+$ ]] || deadline=""
fi
# Run directly, What next says when it terminates itself. Run by make aws-up,
# which shows What next only at the end, it's said here.
if top_level; then
  what_next "$deadline"
elif [ "$deadline" = none ]; then
  echo
  echo "It has no time limit, so it costs about \$18 a month until you run make aws-destroy."
elif [ -n "$deadline" ]; then
  echo
  echo "It terminates itself, with its data, at $(describe_deadline "$deadline")."
fi
