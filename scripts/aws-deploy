#!/usr/bin/env bash
# Create (or update) your AWS test deployment with Terraform: the Compose stack
# at a given commit, on an EC2 instance reachable only from this computer's
# public IP. See docs/deploying-to-aws.md.
#
# Usage: scripts/aws-deploy            (make aws-deploy)
#        REF=<branch|tag|commit> scripts/aws-deploy
#
# The server runs REF (default HEAD). It clones REF from REPOSITORY_URL if
# that's set, or else from whichever GitHub remote has it, such as your fork.
# The server clones without signing in, so that repository has to be public.
# The AWS project is the one make aws-up or make aws-project last chose, and
# the Region is that project's, or AWS_REGION. Rerunning it with the same commit
# after your IP changes updates only the allowed source IP; another commit
# replaces the server, and its data with it. Before changing anything, it says
# in plain words what will change and asks.
set -euo pipefail
cd "$(dirname "$0")/.."

source scripts/aws-common.sh

for tool in terraform aws git curl jq; do
  command -v "$tool" >/dev/null || fail "$tool isn't installed (see docs/deploying-to-aws.md)"
done
[ -f infra/terraform.tfvars ] \
  || fail "infra/terraform.tfvars is missing: copy infra/terraform.tfvars.example and fill in your name and email"
grep --quiet '^[[:space:]]*deployment_name[[:space:]]*=' infra/terraform.tfvars \
  || fail "infra/terraform.tfvars has no deployment_name: add one, such as deployment_name = \"alice\" (see infra/terraform.tfvars.example)"

use_project
access_mode="$(configured_access_mode)"
anthropic_parameter="$(anthropic_parameter "$(deployment_name)")"

ref="${REF:-HEAD}"
commit="$(git rev-parse --verify --quiet "$ref^{commit}")" || fail "$ref isn't a commit"
for file in compose.https.yaml infra/https/Caddyfile infra/https/refresh-address; do
  git cat-file -e "$commit:$file" 2>/dev/null \
    || fail "$ref doesn't include HTTPS support ($file). Deploy a commit with HTTPS support."
done
# Reject earlier HTTPS implementations that lack source-IP access enforcement.
git show "$commit:infra/https/refresh-address" | grep groundline-allowed-cidr >/dev/null \
  || fail "$ref doesn't include HTTPS access-mode support. Deploy a revision with restricted/unrestricted modes."
if [ -n "${REPOSITORY_URL:-}" ]; then
  repository_url="$REPOSITORY_URL"
else
  git fetch --quiet --all --prune
  repository_url="$(remote_with "$commit")" \
    || fail "$ref ($commit) isn't on GitHub yet: push it to your fork or a branch first, since the server clones it from there"
fi
GIT_TERMINAL_PROMPT=0 git ls-remote --quiet "$repository_url" HEAD >/dev/null 2>&1 \
  || fail "the server can't clone $repository_url: it clones without signing in, so the repository has to be public on GitHub"
# What to call the commit: REF_NAME from make aws-up, REF as given, or the branch checked out.
ref_name="${REF_NAME:-${REF:-$(git branch --show-current)}}"

tester_args=()
allowed_cidr=0.0.0.0/0
if [ "$access_mode" = restricted ]; then
  ip="$(public_ipv4)"
  allowed_cidr="$ip/32"
  tester_args=(-var "tester_cidr=$allowed_cidr")
  exposure="application accessible only from $ip over HTTPS; TLS 443 stays public for certificate validation"
else
  exposure="application accessible from any caller IP over HTTPS; protected API endpoints require API keys"
fi

echo "Deploying ${commit:0:7}${ref_name:+ ($ref_name)} from $repository_url"
echo "to $(project_label) in $region, $exposure."

# Checks only that the parameter exists: its value never leaves AWS. make aws-up
# has already warned about a missing key, so only a direct run warns here.
if ! errors="$(aws ssm get-parameter --region "$region" --name "$anthropic_parameter" 2>&1 >/dev/null)"; then
  case "$errors" in
    *ParameterNotFound*)
      if top_level; then
        echo
        warn "the server will have no Anthropic API key: $anthropic_parameter doesn't exist."
        bullet "make aws-smoke works without it; make aws-smoke-live doesn't."
      fi
      ;;
    *) fail "couldn't check $anthropic_parameter: $errors" ;;
  esac
fi
# Its output only matters when it fails.
init_log="$(terraform -chdir=infra init -input=false 2>&1)" || {
  echo "$init_log" >&2
  fail "terraform init failed"
}
# Tells a new server from an updated one below, since only a new one gets a new deadline.
previous_instance="$(terraform -chdir=infra output -raw instance_id 2>/dev/null || true)"

plan_and_apply "Terraform configuration is unchanged for ${commit:0:7}; checking live HTTPS access next." \
  -var "region=$region" ${tester_args[@]+"${tester_args[@]}"} -var "git_ref=$commit" \
  -var "access_mode=$access_mode" \
  -var "repository_url=$repository_url"

instance="$(terraform -chdir=infra output -raw instance_id)"
hours="$(terraform -chdir=infra output -raw auto_terminate_hours)"
# A tester-IP-only tag update preserves the instance. Reconcile its live Caddy
# config through SSM, even after retrying a previously interrupted deployment.
if [ "$instance" = "$previous_instance" ]; then
  doing "Refreshing HTTPS application access on the existing server"
  on_server "set -eu; cd /opt/groundline; attempts=0
until infra/https/refresh-address '$access_mode' '$allowed_cidr'; do
  attempts=\$((attempts + 1)); [ \"\$attempts\" -lt 12 ] || exit 1; sleep 5
done
docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile" 300 \
    || fail "couldn't apply HTTPS access on the server; do not report deployment success; retry make aws-deploy"
fi
if [ -n "$plan_changed" ]; then
  echo
  if [ "$instance" != "$previous_instance" ]; then
    ok "created your server. It takes about 5 to 10 minutes to start."
  else
    ok "updated your server ($instance). It keeps its data."
  fi
fi

# The deadline, as the server's deadline file would hold it. A new server's
# clock starts when it first boots, about a minute from now. An existing one
# keeps its deadline, which only the server knows.
if [ "$hours" = 0 ]; then
  deadline=none
elif [ "$instance" != "$previous_instance" ]; then
  deadline=$(($(date +%s) + hours * 3600 + 60))
else
  deadline="$(on_server "cat $deadline_file" 2>/dev/null | tr -d '[:space:]' || true)"
  [[ "$deadline" =~ ^[0-9]+$ ]] || deadline=""
fi
# Run directly, What next says when it terminates itself. Run by make aws-up,
# which shows What next only at the end, it's said here.
if top_level; then
  what_next "$deadline"
elif [ "$deadline" = none ]; then
  echo
  echo "It has no time limit, so it costs about \$17 a month until you run make aws-destroy."
elif [ -n "$deadline" ]; then
  echo
  echo "It terminates itself, with its data, at $(describe_deadline "$deadline")."
fi
