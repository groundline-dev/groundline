#!/usr/bin/env bash
# Rebuild the SDK's generated code from the API as it is now (ALL-155):
#   1. write the API's OpenAPI description to packages/groundline-client/openapi.json
#   2. run the pinned generator on that file, into _generated/
#   3. put the "don't edit" notice back (the generator deletes the folder first)
#
# After changing the API, run this (make generate-sdk) and commit the changed
# files. CI runs it too (make sdk-check) and fails if the committed copy differs.
#
# Usage: scripts/generate-sdk [output-folder]
# With an output folder it writes openapi.json and _generated/ there and leaves
# the repo alone; make sdk-check uses that to compare without changing files.
set -euo pipefail

# An output folder is read against where you ran the script, not the repo root.
out=""
if [ $# -gt 0 ]; then
  mkdir -p -- "$1"
  out="$(cd -- "$1" && pwd)"
fi

cd "$(dirname "$0")/.."

package=packages/groundline-client
spec=${out:-$package}/openapi.json
generated=${out:-$package/src/groundline_client}/_generated

# The generator runs in a temporary folder, away from the repo's ruff settings, so
# the output doesn't depend on where the repo is.
work="$(mktemp -d)"
# The result is then copied next to where it will live, so replacing the real
# folder is a rename on one disk. A failure before that leaves it as it was.
mkdir -p -- "$(dirname "$generated")"
stage="$(mktemp -d "$(dirname "$generated")/.generate-sdk.XXXXXX")"
trap 'rm -rf "$work" "$stage"' EXIT

uv run python scripts/export_openapi.py "$work/openapi.json"

# The generator is a dev dependency of the SDK, pinned to an exact version in the
# SDK's pyproject.toml.
uv run --package groundline-client openapi-python-client generate \
  --path "$work/openapi.json" \
  --config "$package/generator-config.yaml" \
  --meta none \
  --output-path "$work/_generated"

cat > "$work/_generated/README.md" <<'NOTICE'
# Generated code: don't edit by hand

Everything in this folder is generated from `packages/groundline-client/openapi.json`
by `make generate-sdk`. A change made here by hand is lost the next time it runs,
and CI fails if the committed copy differs from what the generator produces.

To change it, change the API and run `make generate-sdk` from the repository root.
NOTICE

cp -R "$work/_generated" "$stage/_generated"
cp "$work/openapi.json" "$stage/openapi.json"

# Replacing the whole folder, not overwriting into it, also drops the module of an
# endpoint that was removed from the API; otherwise the freshness check would
# never notice it. The old folder is kept until the new one is in place.
if [ -e "$generated" ]; then
  mv -- "$generated" "$stage/previous"
fi
if ! mv -- "$stage/_generated" "$generated"; then
  if [ -e "$stage/previous" ]; then mv -- "$stage/previous" "$generated"; fi
  echo "generate-sdk: couldn't replace $generated; it is as it was" >&2
  exit 1
fi
mv -- "$stage/openapi.json" "$spec"

echo "generated $generated from $spec: commit the changed files"
