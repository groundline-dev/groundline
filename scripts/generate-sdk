#!/usr/bin/env bash
# Rebuild the SDK's generated code from the API as it is now (ALL-155):
#   1. write the API's OpenAPI description to packages/groundline-client/openapi.json
#   2. run the pinned generator on that file, into _generated/
#   3. put the "don't edit" notice back (the generator deletes the folder first)
#
# After changing the API, run this (make generate-sdk) and commit the changed
# files. CI runs it too (make sdk-check) and fails if the committed copy differs.
#
# Usage: scripts/generate-sdk [output-folder]
# With an output folder it writes openapi.json and _generated/ there and leaves
# the repo alone; make sdk-check uses that to compare without changing files.
set -euo pipefail
cd "$(dirname "$0")/.."

package=packages/groundline-client
if [ $# -gt 0 ]; then
  out="$1"
else
  out=""
fi
spec=${out:-$package}/openapi.json
generated=${out:-$package/src/groundline_client}/_generated

uv run python scripts/export_openapi.py "$spec"

# --overwrite only replaces the files the generator writes. Without clearing the
# folder first, the module of an endpoint that was removed from the API would
# stay behind, and the freshness check would never notice.
rm -rf -- "${generated:?}"

# The generator is a dev dependency of the SDK, pinned in uv.lock.
uv run --package groundline-client openapi-python-client generate \
  --path "$spec" \
  --config "$package/generator-config.yaml" \
  --meta none \
  --output-path "$generated"

cat > "$generated/README.md" <<'NOTICE'
# Generated code: don't edit by hand

Everything in this folder is generated from `packages/groundline-client/openapi.json`
by `make generate-sdk`. A change made here by hand is lost the next time it runs,
and CI fails if the committed copy differs from what the generator produces.

To change it, change the API and run `make generate-sdk` from the repository root.
NOTICE

echo "generated $generated from $spec: commit the changed files"
