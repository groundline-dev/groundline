#!/usr/bin/env bash
# Destroy your AWS test deployment with Terraform, then ask AWS directly whether the
# instance, security group, IAM role, instance profile and budget are gone.
# It fails if any is still there, or if AWS can't say (an expired sign-in, say).
#
# Usage: scripts/aws-destroy   (make aws-destroy)
#
# Before deleting anything, it says in plain words what will go and asks. It
# leaves the Anthropic API key's parameter, which was created outside
# Terraform, and prints the command to delete it.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/aws-common.sh

anthropic_parameter=/groundline/anthropic-api-key

# Read before destroying: the outputs are gone afterwards. A deployment that
# failed partway may lack some, so a missing one is checked below, not here.
output() { terraform -chdir=infra output -raw "$1" 2>/dev/null || true; }
instance="$(output instance_id)"
region="$(output region)"
group="$(output security_group_id)"
role="$(output iam_role_name)"
profile="$(output instance_profile_name)"
budget="$(output budget_name)"
region="${region:-${AWS_REGION:-$(aws configure get region || true)}}"
[ -n "$region" ] || fail "no AWS Region: run aws configure set region <your project's Region code, such as us-east-2>"
account="$(aws sts get-caller-identity --region "$region" --query Account --output text)" \
  || fail "the AWS CLI isn't signed in: run aws login"

# Destroying doesn't use these values, but Terraform asks for every required
# variable without a default.
plan_and_apply "Nothing to delete: Terraform's state in infra/ lists no resources." -destroy \
  -var "region=$region" -var "tester_cidr=127.0.0.1/32" -var "git_ref=unused"

echo
echo "Checking that everything is gone"
leftover=0

# gone WHAT ID COMMAND...: passes only when COMMAND fails with a not-found error.
# An empty ID means Terraform had no output naming it, so it can't be checked.
gone() {
  local what="$1" id="$2" errors
  shift 2
  if [ -z "$id" ]; then
    error "couldn't check the $what: Terraform had no output naming it"
    leftover=1
    return
  fi
  if errors="$("$@" 2>&1 >/dev/null)"; then
    error "$what $id still exists"
    leftover=1
    return
  fi
  case "$errors" in
    *NotFound* | *NoSuchEntity*) ok "$what $id is gone" ;;
    *)
      error "couldn't check $what $id: $errors"
      leftover=1
      ;;
  esac
}

# A terminated instance stays visible for about an hour, so terminated counts as gone.
if [ -z "$instance" ]; then
  gone instance ""
elif instance_state="$(aws ec2 describe-instances --region "$region" --instance-ids "$instance" \
  --query 'Reservations[0].Instances[0].State.Name' --output text 2>&1)"; then
  if [ "$instance_state" = terminated ]; then
    ok "instance $instance is terminated"
  else
    error "instance $instance is $instance_state, not terminated"
    leftover=1
  fi
else
  case "$instance_state" in
    *NotFound*) ok "instance $instance is gone" ;;
    *) error "couldn't check instance $instance: $instance_state"; leftover=1 ;;
  esac
fi
gone "security group" "$group" aws ec2 describe-security-groups --region "$region" --group-ids "$group"
gone "IAM role" "$role" aws iam get-role --role-name "$role"
gone "instance profile" "$profile" aws iam get-instance-profile --instance-profile-name "$profile"
gone budget "$budget" aws budgets describe-budget --account-id "$account" --budget-name "$budget"

[ "$leftover" = 0 ] \
  || fail "something may be left over; see above, and check the AWS console for resources tagged app=groundline"

echo
echo "The Anthropic API key's parameter is still in Parameter Store. Every deployment in"
echo "this AWS project reads it, so delete it only if no one else here still deploys:"
echo "  aws ssm delete-parameter --name $anthropic_parameter --region $region"
