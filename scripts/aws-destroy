#!/usr/bin/env bash
# Destroy your AWS deployment with Terraform, then ask AWS directly whether the
# instance, security group, IAM role, instance profile, budget, data volume and
# Elastic IP are gone. It fails if any is still there, or if AWS can't say (an
# expired sign-in, say).
#
# Usage: scripts/aws-destroy               (make aws-destroy)
#        scripts/aws-destroy --data delete (make aws-destroy DATA=delete)
#
# A lasting deployment keeps its data volume, its Elastic IP, its pre-upgrade
# snapshot and its Anthropic API key, so make aws-up can bring it back with
# its data, API keys and address. --data delete deletes them too, once you've
# typed the deployment's name. A disposable deployment loses everything either
# way.
#
# It acts on the project make aws-up or make aws-project last chose; to reach a
# deployment in another project, run make aws-project first.
#
# Before deleting anything, it says in plain words what will go and asks. Then
# it deletes the deployment's Anthropic API key parameter, which make aws-up
# created outside Terraform.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/aws-common.sh

delete_data=""
case "$*" in
  "") ;;
  "--data delete") delete_data=yes ;;
  *) fail "usage: make aws-destroy, or make aws-destroy DATA=delete to delete a lasting deployment's data too" ;;
esac

use_project
init_roots

# Read before destroying: the outputs are gone afterwards. A deployment that
# failed partway may lack some, so a missing one is checked below, not here.
output() { terraform -chdir="${2:-infra}" output -raw "$1" 2>/dev/null || true; }
instance="$(output instance_id)"
group="$(output security_group_id)"
role="$(output iam_role_name)"
profile="$(output instance_profile_name)"
budget="$(output budget_name)"
anthropic_parameter="$(output anthropic_parameter_name)"
volume="$(output volume_id infra/data)"
address="$(output eip_allocation_id infra/data)"
# The deployment's name, from its state if it has a data volume: the server's
# Terraform finds the volume and address by it, so destroying needs it.
name="$(output deployment_name infra/data)"
name="${name:-$(deployment_name)}"
anthropic_parameter="${anthropic_parameter:-${name:+$(anthropic_parameter "$name")}}"
# The lifetime the deployment was made with, from its state; infra/data/ still
# says once make aws-destroy has kept a lasting deployment's data.
lifetime="$(output lifetime)"
lifetime="${lifetime:-$(output lifetime infra/data)}"
lifetime="${lifetime:-$(configured_lifetime)}"
size="$(output data_volume_gib infra/data)"
public_ip="$(output public_ip infra/data)"

keep_data=""
if [ "$lifetime" = lasting ] && [ -z "$delete_data" ]; then
  keep_data=yes
  echo "Deleting the server of your lasting deployment $name in $(project_label). Its data"
  echo "volume, address, pre-upgrade snapshot and Anthropic API key stay, so make aws-up"
  echo "can bring it back with its data, API keys and address."
elif [ -n "$delete_data" ] && [ -n "$volume$address" ]; then
  echo "This deletes your deployment $name in $(project_label) with its data: the"
  echo "database and every API key in it, its address and its pre-upgrade snapshot."
  bullet "Callers would need a new address and new API keys from a new deployment."
  bullet "There's no backup: nothing can bring the data back."
  ask "To delete $name and its data, type its name"
  [ "$answer" = "$name" ] || fail "canceled: $name and its data are unchanged"
else
  echo "Deleting your test deployment in $(project_label)."
fi

# Plans both folders first, so one question covers the server and the data
# volume and address it was attached to; on a disposable deployment they go
# with it. The server goes first, since the volume can't be deleted while it's
# attached. Destroying uses only the name, which finds the volume and address;
# Terraform asks for the other required variables, and infra/terraform.tfvars
# may be missing.
doing "Working out what will change"
make_plan infra -destroy \
  -var "region=$region" -var "git_ref=unused" -var "access_mode=unrestricted" \
  -var "deployment_name=${name:-unused}" -var "budget_alert_email=unused@example.com"
server_plan="$planned" summary="$planned_summary" data_plan=""
if [ -z "$keep_data" ]; then
  allow_data_deletion=yes make_plan infra/data -destroy \
    -var "region=$region" -var "deployment_name=${name:-unused}"
  data_plan="$planned"
  summary="$summary${summary:+${planned_summary:+$'\n'}}$planned_summary"
fi
apply_plans "nothing to delete: Terraform's state for this project lists no resources." \
  "$summary" infra "$server_plan" infra/data "$data_plan"
changed="$plan_changed"

leftover=0

# A kept lasting deployment's server is gone, and the rest stays for make
# aws-up. Only the server's resources are checked.
if [ -n "$keep_data" ]; then
  if [ -n "$changed" ] || [ -n "$instance$group$role$profile$budget" ]; then
    doing "Checking that the server is gone"
    if [ -n "$instance" ] && instance_state="$(aws ec2 describe-instances --region "$region" \
      --instance-ids "$instance" --query 'Reservations[0].Instances[0].State.Name' --output text 2>&1)" \
      && [ "$instance_state" != terminated ]; then
      check_error "instance $instance is $instance_state, not terminated"
      leftover=1
    else
      check_ok "instance ${instance:-of this deployment} is gone"
    fi
  fi
  [ "$leftover" = 0 ] || {
    echo
    fail "the server may still be running; see above, and check the AWS console"
  }
  monthly="$(kept_data_cost "$size")"
  echo
  ok "deleted the server of $name and kept its data."
  bullet "Its data volume (${volume:-unknown}, ${size:-5} GiB) and address (${public_ip:-unknown}) cost about \$$monthly a month."
  bullet "make aws-up brings $name back with its data, API keys and address."
  bullet "make aws-destroy DATA=delete deletes them, and its data, for good."
  echo
  exit 0
fi

# A deployment's pre-upgrade snapshots go with its data.
if [ -n "$name" ]; then
  snapshots="$(aws ec2 describe-snapshots --region "$region" --owner-ids self \
    --filters "Name=tag:deployment,Values=$name" Name=tag-key,Values=groundline-pre-upgrade \
    --query 'Snapshots[].SnapshotId' --output text 2>/dev/null || true)"
  for snapshot in $snapshots; do
    [ "$snapshot" != None ] || continue
    doing "Deleting the pre-upgrade snapshot $snapshot"
    if aws ec2 delete-snapshot --region "$region" --snapshot-id "$snapshot"; then
      check_ok "deleted $snapshot"
    else
      check_error "couldn't delete $snapshot; delete it in the AWS console"
      leftover=1
    fi
  done
fi

# The server is gone, so nothing needs the Anthropic API key any more.
doing "Deleting your Anthropic API key"
if [ -z "$anthropic_parameter" ]; then
  check_warn "couldn't tell which Anthropic API key parameter is yours: infra/terraform.tfvars has no deployment_name"
elif errors="$(aws ssm delete-parameter --region "$region" --name "$anthropic_parameter" 2>&1 >/dev/null)"; then
  check_ok "deleted it from Parameter Store ($anthropic_parameter)"
  echo
  echo "If anyone else can access this AWS project, they could have copied the key while"
  echo "your server ran. Revoke it in the Anthropic Console if that matters to you."
else
  case "$errors" in
    *ParameterNotFound*) check_ok "no Anthropic API key was stored for this deployment" ;;
    *)
      check_error "couldn't delete $anthropic_parameter: $errors"
      leftover=1
      ;;
  esac
fi

# With no resources in the state and none named, there's nothing to check.
if [ -z "$changed" ] && [ -z "$instance$group$role$profile$budget$volume$address" ]; then
  [ "$leftover" = 0 ] || {
    echo
    fail "your Anthropic API key may still be stored; see above, and check Parameter Store in the AWS console"
  }
  other_deployments
  echo
  exit 0
fi

doing "Checking that everything is gone"

# gone WHAT ID COMMAND...: passes only when COMMAND fails with a not-found error.
# An empty ID means Terraform had no output naming it, so it can't be checked.
gone() {
  local what="$1" id="$2" errors
  shift 2
  if [ -z "$id" ]; then
    check_error "couldn't check the $what: Terraform had no output naming it"
    leftover=1
    return
  fi
  if errors="$("$@" 2>&1 >/dev/null)"; then
    check_error "$what $id still exists"
    leftover=1
    return
  fi
  case "$errors" in
    *NotFound* | *NoSuchEntity*) check_ok "$what $id is gone" ;;
    *)
      check_error "couldn't check $what $id: $errors"
      leftover=1
      ;;
  esac
}

# A lasting deployment whose server an earlier make aws-destroy deleted has no
# server outputs left, and nothing of its server to check. A deployment that
# failed partway has some, and each missing one is reported.
if [ -z "$instance$group$role$profile$budget" ] && [ -n "$volume$address" ]; then
  check_ok "there was no server left to check: it was already deleted, or never made"
else
  # A terminated instance stays visible for about an hour, so terminated counts as gone.
  if [ -z "$instance" ]; then
    gone instance ""
  elif instance_state="$(aws ec2 describe-instances --region "$region" --instance-ids "$instance" \
    --query 'Reservations[0].Instances[0].State.Name' --output text 2>&1)"; then
    if [ "$instance_state" = terminated ]; then
      check_ok "instance $instance is terminated"
    else
      check_error "instance $instance is $instance_state, not terminated"
      leftover=1
    fi
  else
    case "$instance_state" in
      *NotFound*) check_ok "instance $instance is gone" ;;
      *) check_error "couldn't check instance $instance: $instance_state"; leftover=1 ;;
    esac
  fi
  gone "security group" "$group" aws ec2 describe-security-groups --region "$region" --group-ids "$group"
  gone "IAM role" "$role" aws iam get-role --role-name "$role"
  gone "instance profile" "$profile" aws iam get-instance-profile --instance-profile-name "$profile"
  gone budget "$budget" aws budgets describe-budget --account-id "$account" --budget-name "$budget"
fi
# A server made before deployments had a data volume has neither.
if [ -n "$volume$address" ]; then
  gone "data volume" "$volume" aws ec2 describe-volumes --region "$region" --volume-ids "$volume"
  gone "Elastic IP" "$address" aws ec2 describe-addresses --region "$region" --allocation-ids "$address"
fi

[ "$leftover" = 0 ] || {
  echo
  fail "something may be left over; see above, and check the AWS console for resources tagged app=groundline"
}

echo
ok "your deployment is deleted. To deploy again, run make aws-up."
other_deployments
echo
