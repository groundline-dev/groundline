#!/usr/bin/env bash
# Start the Compose stack and check that:
#   - /health and /ready answer 200
#   - Postgres refuses a wrong password
#   - the app container doesn't have the admin password
#   - an API key created with `groundline keys create` still works after the
#     containers are removed and started again
#   - both evaluators run their packaged presets/prompts against a model double
#
# Usage: scripts/docker-smoke-test   (`make docker-smoke` builds the image, then
# runs this)
#
# It runs as its own Compose project, with random passwords and ports that
# Docker picks, so it doesn't share containers, ports or the database volume
# with a stack you have running. Its cleanup removes only its own data.
set -euo pipefail
cd "$(dirname "$0")/.."

project="groundline-smoke"
compose=(docker compose --project-name "$project" -f compose.yaml -f compose.smoke.yaml)

# When Compose fills in ${...}, these shell variables override .env.
POSTGRES_PASSWORD="$(openssl rand -hex 24)"
GROUNDLINE_DB_PASSWORD="$(openssl rand -hex 24)"
export POSTGRES_PASSWORD GROUNDLINE_DB_PASSWORD
export APP_BIND_ADDRESS=127.0.0.1 APP_HOST_PORT=0 POSTGRES_HOST_PORT=0

fail() {
  echo "error: $*" >&2
  echo "--- compose logs ---" >&2
  "${compose[@]}" logs --no-color >&2 || true
  exit 1
}

cleanup() { "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true; }
trap cleanup EXIT

start() {
  local output
  # --wait returns only once Postgres and the app pass their healthchecks, so the
  # checks below don't run before the migrations finish.
  output="$("${compose[@]}" up --detach --wait --wait-timeout 120 --quiet-pull 2>&1)" \
    || fail "docker compose up --wait failed:
$output"
  address="$("${compose[@]}" port app 8000)" || fail "could not find the app's published port"
  [ -n "$address" ] || fail "the app has no published port"
}

# expect STATUS METHOD PATH [--json BODY] [--header HEADER]
expect() {
  local expected="$1" method="$2" path="$3" body status
  shift 3
  body="$(mktemp)" || fail "could not create HTTP response file"
  if ! status="$(curl --silent --show-error --noproxy '*' --max-time 10 \
    --output "$body" --write-out '%{http_code}' --request "$method" \
    "$@" "http://$address$path")"; then
    rm -f "$body"
    fail "$method $path: request through published port $address failed"
  fi
  if [ "$status" != "$expected" ]; then
    local response
    response="$(cat "$body")"
    rm -f "$body"
    fail "$method $path: expected $expected, got $status: $response"
  fi
  rm -f "$body"
  echo "ok: $method $path returned $status through $address"
}

start
expect 200 GET /health
expect 200 GET /ready

# Connect from the app container with a wrong password. A Postgres that
# trusts connections would let it in, so a refusal shows it checks passwords.
refused="$("${compose[@]}" exec -T app python -c '
import psycopg
try:
    psycopg.connect("host=postgres dbname=groundline user=groundline password=wrong-password connect_timeout=5")
except psycopg.OperationalError as error:
    print(error)
else:
    print("connected")
' 2>&1 || true)"
case "$refused" in
  *"password authentication failed"*) echo "ok: Postgres refused a wrong password" ;;
  *) fail "Postgres didn't refuse a wrong password: $refused" ;;
esac

if "${compose[@]}" exec -T app env | grep --quiet --fixed-strings \
  -e "$POSTGRES_PASSWORD" -e DATABASE_ADMIN_URL; then
  fail "the app container can see the admin password"
fi
echo "ok: the app container doesn't have the admin password"

created="$("${compose[@]}" exec -T app groundline keys create --name smoke-test)" \
  || fail "groundline keys create failed"
key="$(sed -n 's/^API key: \(gl_[A-Za-z0-9_-]*\)$/\1/p' <<<"$created")"
[ -n "$key" ] || fail "groundline keys create printed no API key"
echo "ok: created an API key"

# Stop and remove the containers, keeping the volume, then start again.
"${compose[@]}" down >/dev/null 2>&1 || fail "docker compose down failed"
start

# Authentication runs before the body is checked: an accepted key reaches
# validation (422), an unknown one is turned away (401).
expect 401 POST /v1/omissions --json '{}' --header "Authorization: Bearer gl_unknown"
expect 422 POST /v1/omissions --json '{}' --header "Authorization: Bearer $key"
echo "ok: the API key survived restarting the stack"

"${compose[@]}" exec -T app python /smoke.py evaluate --api-key "$key" \
  || fail "evaluator checks failed"
