#!/usr/bin/env bash
# Check your AWS test deployment from this computer:
#   - /health answers 200, waiting up to 15 minutes for the server to start
#   - API keys work: an empty POST /v1/omissions gets 401 with an unknown API
#     key, and 422 with one created on the server through SSM Run Command. The
#     server checks the API key before the body, so 422 shows the key was
#     accepted, which needs the app, Postgres and its migrations. The empty body
#     is rejected before any Claude call.
#   - with --live, one real commission check answers 200 (under a cent)
#
# Usage: scripts/aws-smoke-test          (make aws-smoke)
#        scripts/aws-smoke-test --live   (make aws-smoke-live)
#
# It revokes its API key at the end, even when a check fails: SSM keeps each
# command's output, so the API key is in SSM's history.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/aws-common.sh

anthropic_parameter=/groundline/anthropic-api-key
wait_minutes=15

live=false
case "${1:-}" in
  --live) live=true ;;
  "") ;;
  *) echo "usage: $0 [--live]" >&2; exit 2 ;;
esac

# With nothing deployed, terraform output exits 0 and prints nothing, so an empty
# value counts as missing too.
output() {
  local value
  value="$(terraform -chdir=infra output -raw "$1")" && [ -n "$value" ] \
    || fail "no $1 in the Terraform state: run make aws-deploy first"
  printf '%s' "$value"
}
instance="$(output instance_id)"
region="$(output region)"
app_url="$(output app_url)"

# A server that terminated itself fails here, with the aws-destroy reminder,
# instead of after waiting for /health.
require_running

if $live; then
  # Checks only that the parameter exists: its value never leaves AWS.
  if ! errors="$(aws ssm get-parameter --region "$region" --name "$anthropic_parameter" 2>&1 >/dev/null)"; then
    case "$errors" in
      *ParameterNotFound*)
        fail "$anthropic_parameter doesn't exist, so the server has no Anthropic API key (see docs/deploying-to-aws.md)" ;;
      *) fail "couldn't check $anthropic_parameter: $errors" ;;
    esac
  fi
fi

# In a terminal, one line shows the time so far, rewritten every 10 seconds or so.
# Elsewhere, such as in a log, a line a minute says it's still waiting.
started=$SECONDS
deadline=$((SECONDS + wait_minutes * 60))
last_minute=-1
until [ "$(curl --silent --max-time 10 --output /dev/null --write-out '%{http_code}' "$app_url/health" || true)" = 200 ]; do
  elapsed=$((SECONDS - started))
  if [ -t 1 ]; then
    printf '\rWaiting for the server to start... %d:%02d' $((elapsed / 60)) $((elapsed % 60))
  elif [ $((elapsed / 60)) != "$last_minute" ]; then
    last_minute=$((elapsed / 60))
    echo "Waiting for the server to start... $last_minute min"
  fi
  if [ "$SECONDS" -ge "$deadline" ]; then
    [ -t 1 ] && echo
    require_running
    echo "--- the server's startup log ---" >&2
    on_server "tail -n 80 /var/log/groundline-bootstrap.log; cd /opt/groundline && docker compose ps --all && docker compose logs --tail 40" >&2 || true
    fail "the server didn't start within $wait_minutes minutes: $app_url/health never answered 200"
  fi
  sleep 10
done
# Ends the rewritten line, if there was one.
[ -t 1 ] && [ "$SECONDS" -gt "$started" ] && echo

if $live; then
  echo "Checking the server. The last check calls Claude, which costs under a cent:"
else
  echo "Checking the server, without calling Claude:"
fi
ok "the server answers (GET /health returned 200)"

keys_create_output="$(on_server "cd /opt/groundline && docker compose exec -T app groundline keys create --name aws-smoke-test")" \
  || fail "groundline keys create failed on the server: $keys_create_output"
api_key_id="$(sed -n 's/^ID: \([0-9a-f-]*\)$/\1/p' <<<"$keys_create_output")"
api_key="$(sed -n 's/^API key: \(gl_[A-Za-z0-9_-]*\)$/\1/p' <<<"$keys_create_output")"
[ -n "$api_key_id" ] && [ -n "$api_key" ] || fail "groundline keys create printed no API key"

revoke() {
  if on_server "cd /opt/groundline && docker compose exec -T app groundline keys revoke $api_key_id" >/dev/null; then
    ok "revoked the test API key"
  else
    warn "couldn't revoke the test API key; revoke it with make aws-key REVOKE=$api_key_id"
  fi
}
trap revoke EXIT
ok "created a test API key on the server"

# expect STATUS SHOWS FAILURE METHOD PATH [curl arguments...]: send the request,
# and say what passing SHOWS or, on any other status, what FAILURE means.
expect() {
  local want="$1" shows="$2" failure="$3" method="$4" path="$5"
  shift 5
  local got
  got="$(curl --silent --max-time 120 --output /dev/null --write-out '%{http_code}' \
    --request "$method" "$@" "$app_url$path" || true)"
  [ "$got" = "$want" ] || fail "$failure ($method $path returned ${got:-nothing}, expected $want)"
  ok "$shows"
}

# Both send an empty body. The server checks the API key before the body, so the
# test API key gets 422 for the missing fields, and Claude is never called.
expect 401 "an unknown API key is turned away (401)" \
  "the server didn't turn away an unknown API key" \
  POST /v1/omissions --json '{}' --header "Authorization: Bearer gl_unknown"
expect 422 "the test API key is accepted: the empty request got past the key check and was
    rejected only for its missing fields (422), so the app, Postgres and API keys work" \
  "the server didn't accept the API key it just created" \
  POST /v1/omissions --json '{}' --header "Authorization: Bearer $api_key"

if $live; then
  # The shortest test input: a short transcript and a note with one changed dose.
  body="$(uv run --quiet python -c '
import json
from tests.commissions_helpers import SUMMARY
from tests.omission_helpers import SOURCE
print(json.dumps({"source": SOURCE, "summary": SUMMARY}))
')"
  expect 200 "a real commission check got an answer from Claude (200)" \
    "the commission check failed; a 503 means the server has no Anthropic API key" \
    POST /v1/commissions --json "$body" --header "Authorization: Bearer $api_key"
fi

# Every check passed. Revoke the API key now instead of on exit, so the
# reminder is the last thing printed. A failed check exits before this line,
# and the exit trap revokes the key then.
trap - EXIT
revoke
echo
echo "All checks passed. The server is still running and costing money; make aws-status"
echo "shows when it terminates itself. When you're done, run make aws-destroy."
