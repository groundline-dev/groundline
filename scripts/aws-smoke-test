#!/usr/bin/env bash
# Check your AWS test deployment from this computer:
#   - /health answers 200, waiting up to 15 minutes for the server to start
#   - an API key created on the server through SSM Run Command is accepted:
#     an empty POST /v1/omissions gets 401 with an unknown API key and 422 with
#     the new one, since the API key is checked before the body. No Claude call
#     is made.
#   - with --live, one real commission check answers 200 (under a cent)
#
# Usage: scripts/aws-smoke-test          (make aws-smoke)
#        scripts/aws-smoke-test --live   (make aws-smoke-live)
#
# It revokes its API key at the end, even when a check fails: SSM keeps each
# command's output, so the API key is in SSM's history.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/aws-common.sh

anthropic_parameter=/groundline/anthropic-api-key
wait_minutes=15

live=false
case "${1:-}" in
  --live) live=true ;;
  "") ;;
  *) echo "usage: $0 [--live]" >&2; exit 2 ;;
esac

# With nothing deployed, terraform output exits 0 and prints nothing, so an empty
# value counts as missing too.
output() {
  local value
  value="$(terraform -chdir=infra output -raw "$1")" && [ -n "$value" ] \
    || fail "no $1 in the Terraform state: run make aws-deploy first"
  printf '%s' "$value"
}
instance="$(output instance_id)"
region="$(output region)"
app_url="$(output app_url)"

# A server that terminated itself fails here, with the aws-destroy reminder,
# instead of after waiting for /health.
require_running

if $live; then
  # Checks only that the parameter exists: its value never leaves AWS.
  if ! errors="$(aws ssm get-parameter --region "$region" --name "$anthropic_parameter" 2>&1 >/dev/null)"; then
    case "$errors" in
      *ParameterNotFound*)
        fail "$anthropic_parameter doesn't exist, so the server has no Anthropic API key (see DEVELOPMENT.md, \"Deploying to AWS\")" ;;
      *) fail "couldn't check $anthropic_parameter: $errors" ;;
    esac
  fi
fi

echo "Waiting up to $wait_minutes minutes for $app_url/health"
deadline=$((SECONDS + wait_minutes * 60))
until [ "$(curl --silent --max-time 10 --output /dev/null --write-out '%{http_code}' "$app_url/health" || true)" = 200 ]; do
  if [ "$SECONDS" -ge "$deadline" ]; then
    require_running
    echo "--- the server's startup log ---" >&2
    on_server "tail -n 80 /var/log/groundline-bootstrap.log; cd /opt/groundline && docker compose ps --all && docker compose logs --tail 40" >&2 || true
    fail "$app_url/health didn't answer 200 within $wait_minutes minutes"
  fi
  sleep 10
done
echo "ok: GET /health returned 200"

keys_create_output="$(on_server "cd /opt/groundline && docker compose exec -T app groundline keys create --name aws-smoke-test")" \
  || fail "groundline keys create failed on the server: $keys_create_output"
api_key_id="$(sed -n 's/^ID: \([0-9a-f-]*\)$/\1/p' <<<"$keys_create_output")"
api_key="$(sed -n 's/^API key: \(gl_[A-Za-z0-9_-]*\)$/\1/p' <<<"$keys_create_output")"
[ -n "$api_key_id" ] && [ -n "$api_key" ] || fail "groundline keys create printed no API key"

revoke() {
  on_server "cd /opt/groundline && docker compose exec -T app groundline keys revoke $api_key_id" >/dev/null \
    && echo "ok: revoked the test API key" \
    || echo "warning: couldn't revoke the test API key $api_key_id; revoke it by hand (DEVELOPMENT.md)" >&2
}
trap revoke EXIT
echo "ok: created a test API key"

# expect STATUS METHOD PATH [curl arguments...]
expect() {
  local want="$1" method="$2" path="$3"
  shift 3
  local got
  got="$(curl --silent --max-time 120 --output /dev/null --write-out '%{http_code}' \
    --request "$method" "$@" "$app_url$path" || true)"
  [ "$got" = "$want" ] || fail "$method $path returned ${got:-nothing}, expected $want"
  echo "ok: $method $path returned $want"
}

expect 401 POST /v1/omissions --json '{}' --header "Authorization: Bearer gl_unknown"
expect 422 POST /v1/omissions --json '{}' --header "Authorization: Bearer $api_key"

if $live; then
  # The shortest test input: a short transcript and a note with one changed dose.
  body="$(uv run --quiet python -c '
import json
from tests.commissions_helpers import SUMMARY
from tests.omission_helpers import SOURCE
print(json.dumps({"source": SOURCE, "summary": SUMMARY}))
')"
  expect 200 POST /v1/commissions --json "$body" --header "Authorization: Bearer $api_key"
fi

# Every check passed. Revoke the API key now instead of on exit, so the
# reminder is the last thing printed. A failed check exits before this line,
# and the exit trap revokes the key then.
trap - EXIT
revoke
echo
echo "All checks passed. The server is still running and costing money; make aws-status"
echo "shows when it terminates itself. When you're done, run make aws-destroy."
