#!/usr/bin/env bash
# Check your AWS test deployment from this computer:
#   - /health answers 200, waiting up to 15 minutes for the server to start
#   - API keys work: an empty POST /v1/omissions gets 401 with an unknown API
#     key, and 422 with one created on the server through SSM Run Command. The
#     server checks the API key before the body, so 422 shows the key was
#     accepted, which needs the app, Postgres and its migrations. The empty body
#     is rejected before any model call.
#   - with --live, one real commission check answers 200 (under a cent)
#
# Usage: scripts/aws-smoke-test          (make aws-smoke)
#        scripts/aws-smoke-test --live   (make aws-smoke-live)
#
# It revokes its API key at the end, even when a check fails: SSM keeps each
# command's output, so the API key is in SSM's history.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/aws-common.sh

# Internal callers can bound recovery checks without changing ordinary smoke defaults.
wait_seconds="${GROUNDLINE_SMOKE_WAIT_SECONDS:-900}"
request_timeout="${GROUNDLINE_SMOKE_REQUEST_TIMEOUT:-300}"
[[ "$wait_seconds" =~ ^[1-9][0-9]*$ ]] && [[ "$request_timeout" =~ ^[1-9][0-9]*$ ]] \
  || fail "smoke timeouts must be positive whole seconds"

live=false
case "${1:-}" in
  --live) live=true ;;
  "") ;;
  *) echo "usage: $0 [--live]" >&2; exit 2 ;;
esac

use_project
instance="$(output instance_id)"
app_url="$(output app_url)"
access_mode="$(deployed_access_mode)"
allowed_cidr="$(output allowed_cidr)"
public_ip="$(output public_ip)"
uv run --no-project --quiet python scripts/https_check.py "$app_url" "$public_ip" --validate-only --source-filter "$access_mode" --allowed-cidr "$allowed_cidr" \
  || fail "invalid HTTPS endpoint in Terraform state"
unset CURL_CA_BUNDLE SSL_CERT_FILE SSL_CERT_DIR

tls_errors="$(mktemp)"
trap 'rm -f "$tls_errors"' EXIT

# A server that terminated itself fails here, with the aws-destroy reminder,
# instead of after waiting for /health.
require_running

if $live; then
  anthropic_parameter="$(output anthropic_parameter_name)"
  # Checks only that the parameter exists: its value never leaves AWS.
  if ! errors="$(aws ssm get-parameter --region "$region" --name "$anthropic_parameter" 2>&1 >/dev/null)"; then
    case "$errors" in
      *ParameterNotFound*)
        fail "$anthropic_parameter doesn't exist, so the server has no Anthropic API key (see docs/deploying-to-aws.md)" ;;
      *) fail "couldn't check $anthropic_parameter: $errors" ;;
    esac
  fi
fi

# health: the status GET /health returns, or 000 if the server doesn't answer.
health() {
  curl --disable --proto '=https' --silent --show-error --max-time 10 \
    --output /dev/null --write-out '%{http_code}' "$app_url/health" 2>"$tls_errors" || true
}

# Until the server answers, it's asked again every 10 seconds, in the
# background, so the time so far can be shown every second even while a request
# waits up to 10 seconds for an answer. In a terminal, one line shows the time,
# rewritten each second. Elsewhere, such as in a log, a line a minute says it's
# still waiting.
check_access_response() {
  if [ "$access_mode" = restricted ] && [ "$1" = 403 ]; then
    fail "restricted HTTPS denied this source IP (403). Review allowed_cidr and your current network; update the allowed IP with make aws-deploy using the deployed commit, then rerun make aws-smoke."
  fi
}
health_status="$(health)"
check_access_response "$health_status"
if [ "$health_status" = 200 ]; then
  echo
  ok "the server has already started"
else
  echo
  started=$SECONDS
  deadline=$((SECONDS + wait_seconds))
  next_check=$((SECONDS + 10))
  last_minute=-1
  checking=""
  health_file="$(mktemp)"
  while :; do
    if [ -z "$checking" ] && [ "$SECONDS" -ge "$next_check" ]; then
      health >"$health_file" &
      checking=$!
      next_check=$((SECONDS + 10))
    fi
    if [ -n "$checking" ] && ! kill -0 "$checking" 2>/dev/null; then
      wait "$checking" || true
      checking=""
      health_status="$(cat "$health_file")"
      if [ "$health_status" = 403 ] && [ "$access_mode" = restricted ]; then
        rm -f "$health_file"
        check_access_response "$health_status"
      fi
      [ "$health_status" = 200 ] && break
    fi
    elapsed=$((SECONDS - started))
    if [ -t 1 ]; then
      printf '\rWaiting for the server to start... %d:%02d' $((elapsed / 60)) $((elapsed % 60))
    elif [ $((elapsed / 60)) != "$last_minute" ]; then
      last_minute=$((elapsed / 60))
      echo "Waiting for the server to start... $last_minute min"
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      [ -t 1 ] && echo
      rm -f "$health_file"
      require_running
      cat "$tls_errors" >&2
      echo "--- the server's startup log ---" >&2
      on_server "tail -n 80 /var/log/groundline-bootstrap.log; cd /opt/groundline && docker compose ps --all && docker compose logs --tail 40" >&2 || true
      fail "the server didn't start within $wait_seconds seconds: $app_url/health never answered 200"
    fi
    sleep 1
  done
  rm -f "$health_file"
  # Ends the rewritten line.
  [ -t 1 ] && echo
fi

if $live; then
  doing "Checking the server, with one call to the model that costs under a cent"
else
  doing "Checking the server, without calling the model"
fi
check_ok "the server answers (GET /health returned 200)"
https_output="$(uv run --no-project --quiet python scripts/https_check.py "$app_url" "$public_ip")" \
    || fail "HTTPS trust, IP identity, no-SNI or port-isolation check failed: $https_output"
check_results <<<"$https_output"
access_output="$(on_server "cd /opt/groundline && docker compose exec -T app python - '$app_url' '$public_ip' --source-filter '$access_mode' --allowed-cidr '$allowed_cidr' < scripts/https_check.py")" \
  || fail "live HTTPS source-IP policy check failed: $access_output"
check_results <<<"$access_output"

keys_create_output="$(on_server "cd /opt/groundline && docker compose exec -T app groundline-core keys create --name aws-smoke-test")" \
  || fail "groundline-core keys create failed on the server: $keys_create_output"
api_key_id="$(sed -n 's/^ID: \([0-9a-f-]*\)$/\1/p' <<<"$keys_create_output")"
api_key="$(sed -n 's/^API key: \(gl_[A-Za-z0-9_-]*\)$/\1/p' <<<"$keys_create_output")"
[ -n "$api_key_id" ] && [ -n "$api_key" ] || fail "groundline-core keys create printed no API key"

revoke() {
  if on_server "cd /opt/groundline && docker compose exec -T app groundline-core keys revoke $api_key_id" >/dev/null; then
    check_ok "revoked the test API key"
  else
    check_warn "couldn't revoke the test API key; revoke it with make aws-key REVOKE=$api_key_id"
    return 1
  fi
}
trap 'status=$?; revoke || status=1; rm -f "$tls_errors"; exit "$status"' EXIT
check_ok "created a test API key on the server"

# expect STATUS SHOWS FAILURE METHOD PATH [curl arguments...]: send the request,
# and say what passing SHOWS or, on any other status, what FAILURE means.
expect() {
  local want="$1" shows="$2" failure="$3" method="$4" path="$5"
  shift 5
  local got
  got="$(curl --disable --proto '=https' --silent --show-error --max-time "$request_timeout" --output /dev/null --write-out '%{http_code}' \
    --request "$method" "$@" "$app_url$path" || true)"
  [ "$got" = "$want" ] || fail "$failure ($method $path returned ${got:-nothing}, expected $want)"
  check_ok "$shows"
}

# Both send an empty body. The server checks the API key before the body, so the
# test API key gets 422 for the missing fields, and Claude is never called.
expect 401 "an unknown API key is turned away (401)" \
  "the server didn't turn away an unknown API key" \
  POST /v1/omissions --json '{}' --header "Authorization: Bearer gl_unknown"
expect 422 "the test API key is accepted: the empty request got past the key check and was
      rejected only for its missing fields (422), so the app, Postgres and API keys work" \
  "the server didn't accept the API key it just created" \
  POST /v1/omissions --json '{}' --header "Authorization: Bearer $api_key"

if $live; then
  # The shortest test input: a short transcript and a note with one changed dose.
  body="$(uv run --no-project --quiet python -c '
import json
from tests.commissions_helpers import SUMMARY
from tests.omission_helpers import SOURCE
print(json.dumps({"source": SOURCE, "summary": SUMMARY}))
')"
  expect 200 "a real commission check got an answer from Claude (200)" \
    "the commission check failed; a 503 means the server has no Anthropic API key" \
    POST /v1/commissions --json "$body" --header "Authorization: Bearer $api_key"
fi

# Every check passed. Revoke the API key now instead of on exit, so the
# reminder is the last thing printed. A failed check exits before this line,
# and the exit trap revokes the key then.
revoke
trap - EXIT
rm -f "$tls_errors"
echo
ok "all checks passed"
what_next
