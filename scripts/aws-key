#!/usr/bin/env bash
# Create an API key on your AWS test deployment and print it, for trying
# requests from its /docs page or with curl; or revoke one.
#
# Usage: scripts/aws-key                 (make aws-key)
#        scripts/aws-key --revoke <ID>   (make aws-key REVOKE=<ID>)
#
# It runs groundline keys on the server through SSM Run Command. SSM keeps each
# command's output, so anyone who can read the AWS project's Run Command history
# can see the API key. The API key goes when the server does.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/aws-common.sh

# With nothing deployed, terraform output exits 0 and prints nothing.
instance="$(terraform -chdir=infra output -raw instance_id 2>/dev/null || true)"
region="$(terraform -chdir=infra output -raw region 2>/dev/null || true)"
[ -n "$instance" ] && [ -n "$region" ] || fail "nothing is deployed from this folder: run make aws-deploy"
app_url="$(terraform -chdir=infra output -raw app_url)"

keys() {
  on_server "cd /opt/groundline && docker compose exec -T app groundline keys $1"
}

case "${1:-}" in
  "")
    require_running
    created="$(keys "create --name demo")" || fail "groundline keys create failed on the server: $created"
    id="$(sed -n 's/^ID: //p' <<<"$created")"
    echo "$created"
    cat <<EOF

To try a request, open $app_url/docs, choose Authorize and paste the API key.
Anyone who can read this AWS project's Run Command history can see it. It goes
when the server does; to revoke it sooner, run make aws-key REVOKE=$id
EOF
    ;;
  --revoke)
    id="${2:-}"
    # The ID goes into a command run on the server, so it has to be a UUID.
    [[ "$id" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] \
      || fail "REVOKE should be an API key's ID, a UUID such as 0b6c8a5e-1f2d-4c3b-9a8e-7d6f5e4c3b2a, not '$id'"
    require_running
    keys "revoke $id" || fail "groundline keys revoke failed on the server"
    ;;
  *)
    echo "usage: $0 [--revoke <ID>]" >&2
    exit 2
    ;;
esac
